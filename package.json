		"dotenv": "^17.2.3",
		"prisma": "^7.2.0",
		"svelte": "^5.46.1",
		"svelte-check": "^4.3.5",
		"typescript": "^7.0.0-dev.20251228.1",
		"vite": "^7.3.0"
	},
