// ASPIRATIONAL v2 — see DESIGN.md (reviewed).
// Specter paths + --> / !<-- stay. Naming conventions / trailing > go.
// Clojure map literals. Destructuring. Deep if allowed. Bare |hash (open).

module Match

pstate $$matches {
  String -> fixed {
    "homeTeamId" String
    "awayTeamId" String
    "seasonId" String
    "status" String
    "homeScore" Long
    "awayScore" Long
    "winnerId" String
    "boGames" Long
  }
}

pstate $$map-bans {
  String -> fixed {
    "turn" Long
    "homeTeamId" String
    "awayTeamId" String
    "remaining" Object
    "actions" Object
  }
}

pstate $$team-stats {
  String -> fixed {
    "wins" Long
    "losses" Long
    "points" Long
  }
}

pstate $$matches-by-team {
  String -> map String
}

depot match-depot keyed-by matchId

op create-match(event) {
  let { matchId, homeTeamId, awayTeamId, seasonId, boGames, pool } = event
  let bo = long(boGames)
  let pool-set = set(pool)

  $$matches --> keypath(matchId) > existing

  if (nil?(existing)) {
    // fixed-keys record write = one multi-path (Specter), not N transforms
    $$matches !<-- keypath(matchId), multi-path(
      ["homeTeamId" termval(homeTeamId)]
      ["awayTeamId" termval(awayTeamId)]
      ["seasonId" termval(seasonId)]
      ["status" termval("UNPLAYED")]
      ["homeScore" termval(0)]
      ["awayScore" termval(0)]
      ["boGames" termval(bo)]
    )

    $$map-bans !<-- keypath(matchId), multi-path(
      ["turn" termval(0)]
      ["homeTeamId" termval(homeTeamId)]
      ["awayTeamId" termval(awayTeamId)]
      ["remaining" termval(pool-set)]
      ["actions" termval([])]
    )

    |hash homeTeamId
    $$matches-by-team !<-- keypath(homeTeamId, matchId), termval(seasonId)
    |hash awayTeamId
    $$matches-by-team !<-- keypath(awayTeamId, matchId), termval(seasonId)

    ack {"ok" true "matchId" matchId}
  } else {
    ack {"ok" false "error" "match-exists"}
  }
}

op ban-map(event) {
  let { matchId, teamId, arenaId } = event

  $$map-bans --> keypath(matchId) > { turn, homeTeamId, awayTeamId, remaining }

  if (nil?(turn)) {
    ack {"ok" false "error" "no-ban-state"}
  } else {
    let expected = even?(turn) ? awayTeamId : homeTeamId
    if (not=(teamId, expected)) {
      ack {"ok" false "error" "not-your-turn"}
    } else {
      if (not(contains?(remaining, arenaId))) {
        ack {"ok" false "error" "arena-not-in-pool"}
      } else {
        let next-remaining = disj(remaining, arenaId)
        let next-turn = inc(turn)

        $$map-bans !<-- keypath(matchId), multi-path(
          ["remaining" termval(next-remaining)]
          ["turn" termval(next-turn)]
        )
        // navigator is a sibling path step — never inside keypath
        $$map-bans !<-- keypath(matchId, "actions"), AFTER-ELEM, termval({"teamId" teamId "arenaId" arenaId})

        ack {"ok" true "matchId" matchId "banned" arenaId "turn" next-turn}
      }
    }
  }
}

op submit-score(event) {
  let { matchId, homeScore, awayScore } = event
  let hs = long(homeScore)
  let as = long(awayScore)

  $$matches --> keypath(matchId) > { status, homeTeamId, awayTeamId, boGames }

  if (nil?(status)) {
    ack {"ok" false "error" "match-not-found"}
  } else {
    if (not=(status, "UNPLAYED")) {
      ack {"ok" false "error" "already-played"}
    } else {
      if (not(or(and(>=(hs, boGames), >(hs, as)), and(>=(as, boGames), >(as, hs))))) {
        ack {"ok" false "error" "incomplete-or-invalid-score"}
      } else {
        let winnerId = >(hs, as) ? homeTeamId : awayTeamId
        let loserId = =(winnerId, homeTeamId) ? awayTeamId : homeTeamId

        $$matches !<-- keypath(matchId), multi-path(
          ["status" termval("PLAYED")]
          ["homeScore" termval(hs)]
          ["awayScore" termval(as)]
          ["winnerId" termval(winnerId)]
        )

        |hash winnerId
        $$team-stats !<-- keypath(winnerId, "wins"), nil->val(0), term(inc)
        $$team-stats !<-- keypath(winnerId, "points"), nil->val(0), term(inc)
        |hash loserId
        $$team-stats !<-- keypath(loserId, "losses"), nil->val(0), term(inc)

        ack {"ok" true "matchId" matchId "winnerId" winnerId "homeScore" hs "awayScore" as}
      }
    }
  }
}
