# Node Environment
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Local development (update with your credentials):
DATABASE_URL="postgresql://postgres:password@localhost:5432/mge_tf"

# Docker PostgreSQL (if using):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/mge_tf"

# Production (Render.com - will be provided by PostgreSQL addon):
# DATABASE_URL="postgresql://user:password@host:port/database"

# Steam Authentication
# Get API key from: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here
# Note: STEAM_REALM and RETURN_URL are auto-detected from request headers

# Discord OAuth
# Create app at: https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:5173/auth/discord/callback

# PayPal Configuration
# For development, use sandbox credentials from: https://developer.paypal.com/
# For production, use live credentials
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# AWS S3 Configuration
# For demo uploads and avatar storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=mge-tf-uploads

# PostHog Analytics
# Create account at: https://posthog.com/
POSTHOG_API_KEY=phc_your_posthog_api_key
POSTHOG_HOST=https://us.i.posthog.com

# Session Configuration
# Generate a random secure string (minimum 32 characters)
SESSION_SECRET=your_random_secret_string_min_32_chars

# Optional: Sentry Error Tracking (for production)
# SENTRY_DSN=https://your_sentry_dsn

# Optional: Custom Configuration
# PORT=5173
# LOG_LEVEL=debug
