# Playwright / local E2E against a real Rama cluster (no Postgres).
DATA_BACKEND=rama
RAMA_CONDUCTOR_URL=http://127.0.0.1:8888
APP_ENVIRONMENT=development
STEAM_API_KEY=test-steam-api-key-not-used
JWT_SECRET=e2e-test-jwt-secret-at-least-32-chars-long
SESSION_SECRET=e2e-test-session-secret-32chars!!
PUBLIC_URL=http://127.0.0.1:4173
