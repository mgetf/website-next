{
  "name": "mge-next",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "prisma generate && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo '' && husky",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:prod": "dotenv -e .env.production -- prisma migrate deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundary-check": "bun run scripts/boundary-check.ts",
    "db:studio": "prisma studio",
    "db:studio:prod": "dotenv -e .env.production -- prisma studio",
    "knip": "knip"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.57.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/archiver": "^7.0.0",
    "@types/node": "^25.6.0",
    "brackets-model": "^1.6.2",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "knip": "^6.4.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.1",
    "prisma": "^7.7.0",
    "svelte": "^5.55.4",
    "svelte-check": "^4.4.6",
    "typescript": "^6.0.2",
    "vite": "^8.0.8"
  },
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "@tailwindcss/oxide",
    "prisma"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1031.0",
    "@aws-sdk/s3-request-presigner": "^3.1031.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/jsonwebtoken": "^9.0.10",
    "archiver": "^7.0.1",
    "chart.js": "^4.5.1",
    "fuse.js": "^7.3.0",
    "jsonwebtoken": "^9.0.3",
    "marked": "^18.0.0",
    "node-steam-openid": "^2.0.0",
    "svelte-dnd-action": "^0.9.69",
    "svelte-exmarkdown": "^5.0.2",
    "tailwindcss": "^4.2.2",
    "zod": "^4.3.6"
  },
  "lint-staged": {
    "*.{js,ts,svelte,css,html,json,md,yaml,yml}": "prettier --check"
  }
}
