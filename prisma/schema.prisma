generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum UserRole {
  GUEST
  MODERATOR
  ADMIN
}

enum BanStatus {
  NONE // 0
  WARNING // 1
  SUSPENDED // 2
  BANNED // 3
}

enum Severity {
  WARNING // 0
  SUSPENDED // 1
  BANNED // 2
}

enum MatchStatus {
  UNPLAYED // 0
  PLAYED // 1
  DISPUTE // 2
}

enum TeamStatus {
  DEAD // -1
  UNREADY // 0
  PENDING // 1
  READY // 2
  PLACEMENT // 3
}

enum DemoStatus {
  CLEAR // 0
  REVIEW // 1
  ACTION // 2
}

enum PlayerStatus {
  MEMBER // 0
  ADMIN // 1
  STATUS // 2
}

enum PendingStatus {
  TEAM // 0
  ADMIN // 1
}

enum PaymentStatus {
  UNPAID // 0
  PAID // 1
  PARTIAL // 2
}

enum NotificationType {
  MATCH_COMM // 0
  PENDING_PLAYER // 1
  MATCH_CREATED // 2
  PLAYER_INVITE // 3
  ADMIN_ACTION // 4
  BYE_WEEK // 5
}

enum MapBanActionType {
  BAN
  PICK
}

// ═══════════════════════════════════════════════════════════════════
// Unified Event System enums
// ═══════════════════════════════════════════════════════════════════

enum EventType {
  CUP
  CHAMPIONSHIP
  FIGHT_NIGHT
}

enum EventStatus {
  UPCOMING
  REGISTRATION
  IN_PROGRESS
  COMPLETED
}

enum BracketFormat {
  SINGLE_ELIM
  DOUBLE_ELIM
  ROUND_ROBIN
  CARD
}

// Explicit bracket topology section for elimination matches.
// MAIN is used for single-elimination brackets (no winners/losers split).
enum BracketSection {
  MAIN
  WINNERS
  LOSERS
  GRAND_FINAL
}

enum ItemPaymentStatus {
  PENDING
  COMPLETED
  EXPIRED
  CANCELLED
}

// ═══════════════════════════════════════════════════════════════════
// Steam Item Catalog
// ═══════════════════════════════════════════════════════════════════
model SteamItem {
  id             Int     @id @default(autoincrement())
  name           String
  appId          Int     @map("app_id")
  marketHashName String  @unique @map("market_hash_name")
  iconUrl        String? @map("icon_url")

  divisionItemPayments DivisionItemPayment[]

  @@map("steam_items")
}

// ═══════════════════════════════════════════════════════════════════
// Division Item Payment Configuration
// ═══════════════════════════════════════════════════════════════════
model DivisionItemPayment {
  id           Int @id @default(autoincrement())
  divisionId   Int @unique @map("division_id")
  steamItemId  Int @map("steam_item_id")
  itemQuantity Int @map("item_quantity")

  division  Division  @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  steamItem SteamItem @relation(fields: [steamItemId], references: [id])

  @@map("division_item_payments")
}

// ═══════════════════════════════════════════════════════════════════
// Item Payment Orders
// ═══════════════════════════════════════════════════════════════════
model ItemPaymentOrder {
  id                 Int               @id @default(autoincrement())
  orderNumber        String            @unique @map("order_number")
  playerSteamId      String            @map("player_steam_id")
  teamId             Int               @map("team_id")
  seasonId           Int               @map("season_id")
  itemName           String            @map("item_name")
  itemAppId          Int               @map("item_app_id")
  itemMarketHashName String            @map("item_market_hash_name")
  itemsRequired      Int               @map("items_required")
  itemsReceived      Int               @default(0) @map("items_received")
  paidForSteamIds    String[]          @default([]) @map("paid_for_steam_ids")
  status             ItemPaymentStatus @default(PENDING)
  tradeOfferId       String?           @map("trade_offer_id")
  checkoutTeams      String?           @map("checkout_teams")
  createdAt          DateTime          @default(now()) @map("created_at")
  completedAt        DateTime?         @map("completed_at")
  expiresAt          DateTime          @map("expires_at")

  player User   @relation(fields: [playerSteamId], references: [steamId])
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Restrict)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Restrict)

  @@index([playerSteamId, status])
  @@map("item_payment_orders")
}

// ═══════════════════════════════════════════════════════════════════
// Format table (replaces is1v1 magic integer)
// ═══════════════════════════════════════════════════════════════════
model Format {
  id   Int    @id @default(autoincrement())
  name String // Display name: "1v1", "2v2"
  code String @unique // Lookup key: "1v1", "2v2"

  seasons             Season[]
  teams               Team[]
  teamHistory         TeamHistory[]
  activeSignupSeasons ActiveSignupSeason[]

  @@map("formats")
}

// ═══════════════════════════════════════════════════════════════════
// Active signup seasons junction table
// Replaces: Global.naSignupSeasonId, euSignupSeasonId, etc.
// ═══════════════════════════════════════════════════════════════════
model ActiveSignupSeason {
  regionId Int @map("region_id")
  formatId Int @map("format_id")
  seasonId Int @map("season_id")

  region Region @relation(fields: [regionId], references: [id])
  format Format @relation(fields: [formatId], references: [id])
  season Season @relation(fields: [seasonId], references: [id])

  @@id([regionId, formatId])
  @@map("active_signup_seasons")
}

// Models

// ═══════════════════════════════════════════════════════════════════
// Unified Event System
// ═══════════════════════════════════════════════════════════════════

model Event {
  id          Int         @id @default(autoincrement())
  name        String
  type        EventType
  status      EventStatus @default(UPCOMING)
  isTeamEvent Boolean     @default(false) @map("is_team_event")
  description String?
  avatar      String?
  startedAt   DateTime?   @map("started_at")
  endedAt     DateTime?   @map("ended_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  prizepool   Decimal     @default(0) @db.Decimal(10, 2)
  bracketLink String?     @map("bracket_link")
  card        String?

  stages       EventStage[]
  participants EventParticipant[]
  placements   EventPlacement[]
  demos        Demo[]
  draft        EventDraft?
  revisions    EventRevision[]

  @@map("events")
}

model EventStage {
  id            Int           @id @default(autoincrement())
  eventId       Int           @map("event_id")
  name          String
  bracketFormat BracketFormat @map("bracket_format")
  orderNum      Int           @map("order_num")

  event   Event        @relation(fields: [eventId], references: [id])
  matches EventMatch[]

  @@index([eventId, orderNum])
  @@map("event_stages")
}

model EventMatch {
  id         Int         @id @default(autoincrement())
  stageId    Int         @map("stage_id")
  round      Int?
  orderNum   Int         @map("order_num")
  label      String?
  winnerSide Int?        @map("winner_side")
  side1Score Int?        @map("side1_score")
  side2Score Int?        @map("side2_score")
  boSeries   Int         @default(3) @map("bo_series")
  status     MatchStatus @default(UNPLAYED)

  // Explicit topology — replaces label/round-sign inference at render time.
  section           BracketSection? @map("section")
  winnerNextMatchId Int?            @map("winner_next_match_id")
  winnerNextSide    Int?            @map("winner_next_side")
  loserNextMatchId  Int?            @map("loser_next_match_id")
  loserNextSide     Int?            @map("loser_next_side")

  stage             EventStage         @relation(fields: [stageId], references: [id])
  players           EventMatchPlayer[]
  games             EventGame[]
  winnerNextMatch   EventMatch?        @relation("MatchWinnerProgression", fields: [winnerNextMatchId], references: [id], onDelete: SetNull)
  winnerFedFrom     EventMatch[]       @relation("MatchWinnerProgression")
  loserNextMatch    EventMatch?        @relation("MatchLoserProgression", fields: [loserNextMatchId], references: [id], onDelete: SetNull)
  loserFedFrom      EventMatch[]       @relation("MatchLoserProgression")

  @@index([stageId, round, orderNum])
  @@index([winnerNextMatchId])
  @@index([loserNextMatchId])
  @@map("event_matches")
}

model EventMatchPlayer {
  id          Int     @id @default(autoincrement())
  matchId     Int     @map("match_id")
  steamId     String? @map("steam_id")
  displayName String  @map("display_name")
  side        Int

  match EventMatch @relation(fields: [matchId], references: [id])
  user  User?      @relation(fields: [steamId], references: [steamId])

  @@unique([matchId, displayName])
  @@map("event_match_players")
}

model EventGame {
  id         Int       @id @default(autoincrement())
  matchId    Int       @map("match_id")
  gameNumber Int       @map("game_number")
  side1Score Int?      @map("side1_score")
  side2Score Int?      @map("side2_score")
  arenaId    Int?      @map("arena_id")
  playedAt   DateTime? @map("played_at")

  match EventMatch @relation(fields: [matchId], references: [id])
  arena Arena?     @relation(fields: [arenaId], references: [id])

  @@map("event_games")
}

model EventParticipant {
  id         Int      @id @default(autoincrement())
  eventId    Int      @map("event_id")
  steamId    String   @map("steam_id")
  seed       Int?
  eliminated Boolean  @default(false)
  hidden     Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [steamId], references: [steamId])

  @@unique([eventId, steamId])
  @@map("event_participants")
}

model EventPlacement {
  id        Int    @id @default(autoincrement())
  eventId   Int    @map("event_id")
  steamId   String @map("steam_id")
  placement Int

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [steamId], references: [steamId])

  @@unique([eventId, steamId])
  @@map("event_placements")
}

// ═══════════════════════════════════════════════════════════════════
// Admin Tournament Editor — drafts and published revisions
// ═══════════════════════════════════════════════════════════════════

// A working draft of an event's full structure (metadata, stages, matches,
// participants, placements). Stored as a JSON snapshot so admins can edit
// historical or upcoming events without mutating the public tables until
// they explicitly publish. `eventId` is null until the draft's first publish
// creates the underlying Event.
model EventDraft {
  id        Int      @id @default(autoincrement())
  eventId   Int?     @unique @map("event_id")
  payload   Json
  revision  Int      @default(1)
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event   Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  creator User?  @relation("EventDraftCreatedBy", fields: [createdBy], references: [steamId])
  updater User?  @relation("EventDraftUpdatedBy", fields: [updatedBy], references: [steamId])

  @@map("event_drafts")
}

// Immutable snapshot of a published event, recorded every time a draft is
// published. Allows admins to inspect or restore a prior historical version.
model EventRevision {
  id          Int      @id @default(autoincrement())
  eventId     Int      @map("event_id")
  revision    Int
  payload     Json
  summary     String?
  publishedBy String?  @map("published_by")
  publishedAt DateTime @default(now()) @map("published_at")

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  publisher User? @relation("EventRevisionPublishedBy", fields: [publishedBy], references: [steamId])

  @@unique([eventId, revision])
  @@index([eventId])
  @@map("event_revisions")
}

model Demo {
  id            Int      @id @default(autoincrement())
  file          String
  playerSteamId String?  @map("player_steam_id")
  submittedBy   String?  @map("submitted_by")
  submittedAt   DateTime @default(now()) @map("submitted_at")
  matchId       Int?     @map("match_id")
  eventId       Int?     @map("event_id")
  title         String?
  description   String?

  player            User?              @relation("DemoPlayer", fields: [playerSteamId], references: [steamId])
  submitter         User?              @relation("DemoSubmitter", fields: [submittedBy], references: [steamId])
  match Match? @relation(fields: [matchId], references: [id])
  event Event? @relation(fields: [eventId], references: [id])
  reports           DemoReport[]

  @@map("demos")
}

model DemoReport {
  id            Int        @id @default(autoincrement())
  demoId        Int        @map("demo_id")
  reportedBy    String?    @map("reported_by")
  reportedAt    DateTime   @default(now()) @map("reported_at")
  status        DemoStatus @default(REVIEW)
  description   String?
  adminId       String?    @map("admin_id")
  adminComments String?    @map("admin_comments")

  demo     Demo  @relation(fields: [demoId], references: [id])
  reporter User? @relation("DemoReporter", fields: [reportedBy], references: [steamId])
  admin    User? @relation("DemoReportAdmin", fields: [adminId], references: [steamId])

  @@map("demo_report")
}

model Player {
  id            Int      @id @default(autoincrement())
  steamId       String?  @map("steam_id")
  steamUsername String?  @map("steam_username")
  steamAvatar   String?  @map("steam_avatar")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("players")
}

model User {
  steamId         String    @id @map("steam_id")
  steamUsername   String    @map("steam_username")
  steamAvatar     String?   @map("steam_avatar")
  permissionLevel UserRole  @default(GUEST) @map("permission_level")
  banStatus       BanStatus @default(NONE) @map("ban_status")
  nameOverride    Int       @default(0) @map("name_override")
  avatarOverride  Int       @default(0) @map("avatar_override")
  sessionVersion  Int       @default(0) @map("session_version")

  staffDivisions           Division[]                @relation("StaffAssignments")
  discord                  Discord?
  punishmentsReceived      Punishment[]              @relation("PunishedPlayer")
  punishmentsGiven         Punishment[]              @relation("Punisher")
  threads                  Thread[]
  posts                    Post[]
  activities               Activity[]
  matchesSubmitted         Match[]
  matchComms               MatchComm[]
  pendingTeams             PendingPlayer[]
  deniedFromTeams          DeniedPlayer[]
  teamsPlayed              PlayerInTeam[]
  paymentsMadeFor          Payment[]                 @relation("PaymentFor")
  paymentsMadeBy           Payment[]                 @relation("PaymentBy")
  paymentTrackers          PaymentTracker[]
  demosAsPlayer            Demo[]                    @relation("DemoPlayer")
  demosSubmitted           Demo[]                    @relation("DemoSubmitter")
  demoReportsSubmitted     DemoReport[]              @relation("DemoReporter")
  demoReportsHandled       DemoReport[]              @relation("DemoReportAdmin")
  mapBanActions            MapBanAction[]
  notificationsReceived    Notification[]            @relation("NotificationRecipient")
  notificationsTriggered   Notification[]            @relation("NotificationActor")
  auditLogs AuditLog[]
  apiKeys                  ApiKey[]
  eventMatchPlayers        EventMatchPlayer[]
  eventParticipants        EventParticipant[]
  eventPlacements          EventPlacement[]
  itemPaymentOrders        ItemPaymentOrder[]
  mapFilesUploaded         MapFile[]
  eventDraftsCreated       EventDraft[]              @relation("EventDraftCreatedBy")
  eventDraftsUpdated       EventDraft[]              @relation("EventDraftUpdatedBy")
  eventRevisionsPublished  EventRevision[]            @relation("EventRevisionPublishedBy")

  @@map("users")
}

model Discord {
  discordId       String  @id @map("discord_id")
  discordUsername String? @map("discord_username")
  discordAvatar   String? @map("discord_avatar")
  playerSteamId   String? @unique @map("player_steam_id")

  player User? @relation(fields: [playerSteamId], references: [steamId])

  @@map("discord")
}

model Punishment {
  id            Int       @id @default(autoincrement())
  playerSteamId String?   @map("player_steam_id")
  punishedBy    String?   @map("punished_by")
  duration      Int?
  startDateTime DateTime? @map("start_date_time")
  status        Int?
  severity      Severity?
  reason        String?

  player   User? @relation("PunishedPlayer", fields: [playerSteamId], references: [steamId])
  punisher User? @relation("Punisher", fields: [punishedBy], references: [steamId])

  @@map("punishment")
}

model Thread {
  id         Int      @id @default(autoincrement())
  title      String
  content    String
  categories String?
  createdAt  DateTime @default(now()) @map("created_at")
  bumpedAt   DateTime @default(now()) @map("bumped_at")
  owner      String?
  hidden     Int      @default(0)

  user  User?  @relation(fields: [owner], references: [steamId])
  posts Post[]

  @@map("threads")
}

model Post {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  thread    Int
  owner     String?
  hidden    Int      @default(0)

  threadRel Thread @relation(fields: [thread], references: [id])
  user      User?  @relation(fields: [owner], references: [steamId])

  @@map("posts")
}

model Activity {
  id          Int     @id @default(autoincrement())
  threadCount Int     @map("thread_count")
  postCount   Int     @map("post_count")
  period      Int
  owner       String?

  user User? @relation(fields: [owner], references: [steamId])

  @@map("activity")
}


model Arena {
  id         Int     @id @default(autoincrement())
  name       String
  avatar     String?
  playoffMap Int     @default(0) @map("playoff_map")

  games         Game[]
  mapsInPool    MapInPool[]
  mapBanActions MapBanAction[]
  eventGames    EventGame[]

  @@map("arenas")
}

model Season {
  id        Int @id @default(autoincrement())
  seasonNum Int @map("season_num")
  numWeeks  Int @map("num_weeks")
  regionId  Int @map("region_id")
  formatId  Int @map("format_id")

  // Per-season settings (migrated from Global)
  signupsOpen     Boolean   @default(false) @map("signups_open")
  rosterLocked    Boolean   @default(false) @map("roster_locked")
  paymentRequired Boolean   @default(false) @map("payment_required")
  matchWeek       Int?      @map("match_week")
  matchDeadline   DateTime? @map("match_deadline")
  info            String?   @map("info")

  region              Region               @relation(fields: [regionId], references: [id])
  format              Format               @relation(fields: [formatId], references: [id])
  playoffs            Playoff[]
  teams               Team[]
  matches             Match[]
  teamsHistory        TeamHistory[]
  paymentTrackers     PaymentTracker[]
  activeSignupSeasons ActiveSignupSeason[]
  itemPaymentOrders   ItemPaymentOrder[]
  byeWeeks            ByeWeek[]

  @@map("seasons")
}

model Playoff {
  id           Int     @id @default(autoincrement())
  seasonId     Int     @map("season_id")
  numRounds    Int?    @map("num_rounds")
  doubleElim   Int?    @map("double_elim")
  isTournament Boolean @map("is_tournament")

  season  Season  @relation(fields: [seasonId], references: [id])
  matches Match[]

  @@map("playoffs")
}

model Team {
  id                  Int        @id @default(autoincrement())
  name                String
  acronym             String?
  avatar              String?
  wins                Int        @default(0)
  losses              Int        @default(0)
  gamesWon            Int        @default(0) @map("games_won")
  gamesLost           Int        @default(0) @map("games_lost")
  pointsScored        Int        @default(0) @map("points_scored")
  pointsScoredAgainst Int        @default(0) @map("points_scored_against")
  divisionId          Int?       @map("division_id")
  regionId            Int?       @map("region_id")
  seasonId            Int?       @map("season_id")
  formatId            Int        @map("format_id")
  status              TeamStatus @default(UNREADY)
  paymentStatus       Int        @default(0) @map("payment_status")
  joinPassword        String?    @map("join_password")
  createdAt           DateTime   @default(now()) @map("created_at")

  division       Division?         @relation(fields: [divisionId], references: [id])
  region         Region?           @relation(fields: [regionId], references: [id])
  season         Season?           @relation(fields: [seasonId], references: [id])
  format         Format            @relation(fields: [formatId], references: [id])
  homeMatches    Match[]           @relation("HomeTeam")
  awayMatches    Match[]           @relation("AwayTeam")
  wonMatches     Match[]           @relation("WinnerTeam")
  history        TeamHistory[]
  nameHistory    TeamNameHistory[]
  players        PlayerInTeam[]
  pendingPlayers PendingPlayer[]
  deniedPlayers  DeniedPlayer[]
  payments           Payment[]
  mapBanActions      MapBanAction[]
  itemPaymentOrders  ItemPaymentOrder[]
  byeWeeks           ByeWeek[]

  @@map("teams")
}

model TeamHistory {
  id                  Int      @id @default(autoincrement())
  teamId              Int      @map("team_id")
  name                String
  acronym             String?
  avatar              String?
  wins                Int      @default(0)
  losses              Int      @default(0)
  gamesWon            Int      @default(0) @map("games_won")
  gamesLost           Int      @default(0) @map("games_lost")
  pointsScored        Int      @default(0) @map("points_scored")
  pointsScoredAgainst Int      @default(0) @map("points_scored_against")
  divisionId          Int?     @map("division_id")
  regionId            Int?     @map("region_id")
  seasonId            Int      @map("season_id")
  formatId            Int      @map("format_id")
  status              Int      @default(0)
  paymentStatus       Int      @default(0) @map("payment_status")
  joinPassword        String?  @map("join_password")
  createdAt           DateTime @default(now()) @map("created_at")

  team   Team   @relation(fields: [teamId], references: [id])
  season Season @relation(fields: [seasonId], references: [id])
  format Format @relation(fields: [formatId], references: [id])

  @@map("teams_history")
}

model Match {
  id            Int         @id @default(autoincrement())
  homeTeamId    Int         @map("home_team_id")
  awayTeamId    Int         @map("away_team_id")
  winnerId      Int?        @map("winner_id")
  winnerScore   Int?        @map("winner_score")
  loserScore    Int?        @map("loser_score")
  seasonId      Int         @map("season_id")
  seasonNo      Int         @map("season_no")
  playoffId     Int?        @map("playoff_id")
  playoffRound  Int?        @map("playoff_round")
  weekNo        Int?        @map("week_no")
  boSeries      Int?        @map("bo_series")
  boGames       Int?        @map("bo_games")
  matchDateTime    DateTime? @map("match_date_time")
  matchTimezone    String?   @map("match_timezone")
  status           MatchStatus @default(UNPLAYED)
  submittedBy   String?     @map("submitted_by")
  submittedAt   DateTime?   @map("submitted_at")

  homeTeam     Team          @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam     Team          @relation("AwayTeam", fields: [awayTeamId], references: [id])
  winner       Team?         @relation("WinnerTeam", fields: [winnerId], references: [id])
  season       Season        @relation(fields: [seasonId], references: [id])
  playoff      Playoff?      @relation(fields: [playoffId], references: [id])
  submitter    User?         @relation(fields: [submittedBy], references: [steamId])
  demos        Demo[]
  matchComms   MatchComm[]
  games        Game[]
  matchMapBans MatchMapBan[]

  @@map("matches")
}

model Global {
  id                       Int      @id @default(autoincrement())
  leagueFees               Int      @default(0) @map("league_fees")
  botTradeOfferUrl         String?  @map("bot_trade_offer_url")
  botSteamId               String?  @map("bot_steam_id")
  standingsVisibleStatuses String[] @default(["READY", "PENDING"]) @map("standings_visible_statuses")

  @@map("global")
}

model Announcement {
  id      Int    @id @default(autoincrement())
  content String
  visible Int    @default(0)

  @@map("announcements")
}

model Division {
  id         Int    @id @default(autoincrement())
  name       String
  signupCost Float  @default(0.00) @map("signup_cost")
  hidden     Int    @default(0)
  regionId   Int    @map("region_id")

  region       Region               @relation(fields: [regionId], references: [id])
  teams        Team[]
  staffMembers User[]               @relation("StaffAssignments")
  itemPayment  DivisionItemPayment?

  @@unique([name, regionId])
  @@map("divisions")
}

model Region {
  id             Int    @id @default(autoincrement())
  name           String
  hidden         Int    @default(0)
  currencySymbol String @default("€") @map("currency_symbol")
  currencyCode   String @default("EUR") @map("currency_code")

  seasons             Season[]
  teams               Team[]
  divisions           Division[]
  activeSignupSeasons ActiveSignupSeason[]

  @@map("regions")
}

model MatchComm {
  id               Int       @id @default(autoincrement())
  content          String?
  reschedule       String?
  rescheduleStatus Int?      @map("reschedule_status")
  createdAt        DateTime? @map("created_at")
  matchId          Int       @map("match_id")
  owner            String?

  match Match @relation(fields: [matchId], references: [id])
  user  User? @relation(fields: [owner], references: [steamId])

  @@map("match_comms")
}

model Game {
  id                   Int  @id @default(autoincrement())
  matchId Int? @map("match_id")
  gameNum Int  @map("game_num")
  homeTeamScore        Int? @map("home_team_score")
  awayTeamScore        Int? @map("away_team_score")
  arenaId              Int? @map("arena_id")

  match Match? @relation(fields: [matchId], references: [id])
  arena Arena? @relation(fields: [arenaId], references: [id])

  @@map("games")
}

model PendingPlayer {
  playerSteamId String @map("player_steam_id")
  teamId        Int    @map("team_id")
  status        Int    @default(0)

  player User @relation(fields: [playerSteamId], references: [steamId])
  team   Team @relation(fields: [teamId], references: [id])

  @@id([playerSteamId, teamId])
  @@map("pending_players")
}

model DeniedPlayer {
  id            Int      @id @default(autoincrement())
  playerSteamId String   @map("player_steam_id")
  teamId        Int      @map("team_id")
  reason        String?
  adminId       String?  @map("admin_id")
  deniedAt      DateTime @default(now()) @map("denied_at")

  player User @relation(fields: [playerSteamId], references: [steamId])
  team   Team @relation(fields: [teamId], references: [id])

  @@map("denied_players")
}

model TeamNameHistory {
  id         Int      @id @default(autoincrement())
  teamId     Int      @map("team_id")
  name       String
  changeDate DateTime @default(now()) @map("change_date")

  team Team @relation(fields: [teamId], references: [id])

  @@map("teamname_history")
}

model PlayerInTeam {
  playerSteamId   String    @map("player_steam_id")
  teamId          Int       @map("team_id")
  active          Int       @default(1)
  permissionLevel Int       @default(0) @map("permission_level")
  paymentStatus   Int       @default(0) @map("payment_status")
  startedAt       DateTime  @default(now()) @map("started_at")
  leftAt          DateTime? @map("left_at")

  player User @relation(fields: [playerSteamId], references: [steamId])
  team   Team @relation(fields: [teamId], references: [id])

  @@id([playerSteamId, teamId])
  @@map("players_in_teams")
}

model Payment {
  paymentId    String   @id @map("payment_id")
  purchasedFor String   @map("purchased_for")
  purchasedBy  String   @map("purchased_by")
  amount       String
  currency     String?
  purchaseDate DateTime @map("purchase_date")
  description  String?
  teamId       Int?     @map("team_id")

  forUser User  @relation("PaymentFor", fields: [purchasedFor], references: [steamId])
  byUser  User  @relation("PaymentBy", fields: [purchasedBy], references: [steamId])
  team    Team? @relation(fields: [teamId], references: [id])

  @@map("payments")
}

model PaymentTracker {
  id            Int    @id @default(autoincrement())
  playerSteamId String @map("player_steam_id")
  seasonId      Int    @map("season_id")
  amount        Float

  player User   @relation(fields: [playerSteamId], references: [steamId])
  season Season @relation(fields: [seasonId], references: [id])

  @@unique([playerSteamId, seasonId])
  @@map("payment_tracker")
}

model MapBan {
  id         Int     @id @default(autoincrement())
  name       String
  avatar     String?
  playoffMap Int     @default(0) @map("playoff_map")

  @@map("map_bans")
}

model MapBanPool {
  id        Int      @id @default(autoincrement())
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  mapsInPool   MapInPool[]
  matchMapBans MatchMapBan[]

  @@map("map_ban_pools")
}

model MapInPool {
  poolId   Int @map("pool_id")
  arenaId  Int @map("arena_id")
  orderNum Int @map("order_num")

  pool  MapBanPool @relation(fields: [poolId], references: [id])
  arena Arena      @relation(fields: [arenaId], references: [id])

  @@id([poolId, arenaId])
  @@map("maps_in_pool")
}

model MatchMapBan {
  id               Int       @id @default(autoincrement())
  matchId          Int?      @map("match_id")
  poolId           Int?      @map("pool_id")
  currentTurn      Int       @default(0) @map("current_turn")
  banPhaseComplete Boolean   @default(false) @map("ban_phase_complete")
  startedAt        DateTime  @default(now()) @map("started_at")
  completedAt      DateTime? @map("completed_at")

  match   Match?         @relation(fields: [matchId], references: [id])
  pool    MapBanPool?    @relation(fields: [poolId], references: [id])
  actions MapBanAction[]

  @@map("match_map_bans")
}

model MapBanAction {
  id            Int              @id @default(autoincrement())
  matchMapBanId Int?             @map("match_map_ban_id")
  teamId        Int?             @map("team_id")
  playerSteamId String?          @map("player_steam_id")
  arenaId       Int?             @map("arena_id")
  actionType    MapBanActionType @map("action_type")
  actionOrder   Int              @map("action_order")
  createdAt     DateTime         @default(now()) @map("created_at")

  matchMapBan MatchMapBan? @relation(fields: [matchMapBanId], references: [id])
  team        Team?        @relation(fields: [teamId], references: [id])
  player      User?        @relation(fields: [playerSteamId], references: [steamId])
  arena       Arena?       @relation(fields: [arenaId], references: [id])

  @@map("map_ban_actions")
}

model Notification {
  id           Int              @id @default(autoincrement())
  userSteamId  String?          @map("user_steam_id")
  type         NotificationType
  url          String
  message      String?
  actorSteamId String?          @map("actor_steam_id")
  isRead       Boolean          @default(false) @map("is_read")
  createdAt    DateTime         @default(now()) @map("created_at")

  user  User? @relation("NotificationRecipient", fields: [userSteamId], references: [steamId])
  actor User? @relation("NotificationActor", fields: [actorSteamId], references: [steamId])

  @@index([userSteamId, id])
  @@index([userSteamId, createdAt])
  @@index([userSteamId, isRead, createdAt])
  @@map("notifications")
}

// Audit Logging
model AuditLog {
  id         Int      @id @default(autoincrement())
  timestamp  DateTime @default(now())
  actorId    String?  @map("actor_id")
  actorRole  String?  @map("actor_role")
  category   String
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")

  actor User? @relation(fields: [actorId], references: [steamId])

  @@index([category])
  @@index([actorId])
  @@index([targetType, targetId])
  @@index([timestamp])
  @@map("audit_logs")
}

// Site Content Management
model SiteContent {
  id        Int      @id @default(autoincrement())
  key       String   @unique // e.g., "rulebook", "homepage_subtitle", "homepage_about"
  content   String   // Markdown or plain text
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") // Steam ID of last editor

  @@map("site_content")
}

model SiteSettings {
  id                   Int      @id @default(autoincrement())
  siteTitle            String   @default("MGE.tf") @map("site_title")
  faviconPath          String?  @map("favicon_path")
  backgroundImagePath  String?  @map("background_image_path")
  backgroundBlur       Float    @default(0) @map("background_blur")
  backgroundBrightness Float    @default(1) @map("background_brightness")
  backgroundOverlay    Float    @default(0.85) @map("background_overlay")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

// Map File Downloads
model MapFile {
  id           Int      @id @default(autoincrement())
  name         String   @unique // e.g. "mge_chillypunch_final4"
  bspUrl       String   @map("bsp_url")
  bspSize      BigInt   @map("bsp_size")
  cfgUrl       String   @map("cfg_url")
  cfgSize      BigInt   @map("cfg_size")
  description  String?
  uploadedBy   String   @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  uploader User @relation(fields: [uploadedBy], references: [steamId])

  @@map("map_files")
}

// API Key Management
model ApiKey {
  id          Int       @id @default(autoincrement())
  name        String
  key         String    @unique
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  lastUsedAt  DateTime? @map("last_used_at")
  createdBy   String    @map("created_by")

  creator     User      @relation(fields: [createdBy], references: [steamId])

  @@map("api_keys")
}

model ByeWeek {
  id        Int      @id @default(autoincrement())
  teamId    Int      @map("team_id")
  seasonId  Int      @map("season_id")
  seasonNo  Int      @map("season_no")
  weekNo    Int      @map("week_no")
  createdAt DateTime @default(now()) @map("created_at")

  team   Team   @relation(fields: [teamId], references: [id])
  season Season @relation(fields: [seasonId], references: [id])

  @@unique([teamId, seasonId, weekNo])
  @@map("bye_weeks")
}

// MGE Match Logs
model MatchLog {
  id          Int       @id @default(autoincrement())
  mgeMatchId  String    @unique @map("mge_match_id")
  rawLogKey   String    @map("raw_log_key")
  parsedData  Json      @map("parsed_data")
  players     Json      @default("[]") @map("players")
  preview     Json?     @map("preview")
  hostname    String?
  map         String
  arena       String?
  gamemode    String
  format      String
  aborted     Boolean   @default(false)
  startedAt   DateTime? @map("started_at")
  endedAt     DateTime? @map("ended_at")
  durationSec Int?      @map("duration_sec")
  uploadedAt  DateTime  @default(now()) @map("uploaded_at")

  @@index([uploadedAt(sort: Desc)])
  @@map("match_logs")
}