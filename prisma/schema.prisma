// MGE.tf Prisma Schema
// Migrated from Drizzle ORM SQLite schema
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS (PostgreSQL native enums)
// ============================================

enum UserRole {
  GUEST // 0
  USER // 1
  MODERATOR // 2
  ADMIN // 3
}

enum BanStatus {
  NONE // 0
  WARNING // 1
  SUSPENDED // 2
  BANNED // 3
}

enum Severity {
  WARNING // 0
  SUSPENDED // 1
  BANNED // 2
}

enum MatchStatus {
  UNPLAYED // 0
  PLAYED // 1
  DISPUTE // 2
}

enum TeamStatus {
  DEAD // -1
  UNREADY // 0
  PENDING // 1
  READY // 2
  PLACEMENT // 3
}

enum DemoStatus {
  CLEAR // 0
  REVIEW // 1
  ACTION // 2
}

enum PlayerPermission {
  MEMBER // 0
  ADMIN // 1
  STATUS // 2
}

enum PendingStatus {
  TEAM // 0
  ADMIN // 1
}

enum PaymentStatus {
  UNPAID // 0
  PAID // 1
  PARTIAL // 2
}

enum NotificationType {
  MATCH_COMM // 0
  PENDING_PLAYER // 1
}

enum ActionType {
  BAN
  PICK
}

// ============================================
// MODELS
// ============================================

// Core User Models
model User {
  steamId         String    @id @map("steam_id")
  steamUsername   String    @map("steam_username")
  steamAvatar     String?   @map("steam_avatar")
  permissionLevel UserRole  @default(GUEST) @map("permission_level")
  banStatus       BanStatus @default(NONE) @map("ban_status")
  nameOverride    Int       @default(0) @map("name_override")

  // Relations
  discord                    Discord?
  punishmentsGiven           Punishment[]              @relation("PunishmentGiver")
  punishmentsReceived        Punishment[]              @relation("PunishmentReceiver")
  threads                    Thread[]
  posts                      Post[]
  activities                 Activity[]
  moderator                  Moderator?
  teamsPlayers               PlayerInTeam[]
  pendingPlayers             PendingPlayer[]
  deniedPlayers              DeniedPlayer[]
  payments                   Payment[]                 @relation("PaymentPurchaser")
  paymentsPurchasedFor       Payment[]                 @relation("PaymentRecipient")
  paymentTrackers            PaymentTracker[]
  matchComms                 MatchComm[]
  notifications              Notification[]
  demos                      Demo[]                    @relation("DemoPlayer")
  demosSubmitted             Demo[]                    @relation("DemoSubmitter")
  demoReports                DemoReport[]
  demoReportAdmins           DemoReport[]              @relation("DemoReportAdmin")
  matchesSubmitted           Match[]
  mapBanActions              MapBanAction[]
  championshipParticipants   ChampionshipParticipant[]
  championshipMatchesPlayer1 ChampionshipMatch[]       @relation("Player1")
  championshipMatchesPlayer2 ChampionshipMatch[]       @relation("Player2")
  championshipMatchesWinner  ChampionshipMatch[]       @relation("Winner")
  championshipMatchesLoser   ChampionshipMatch[]       @relation("Loser")
  championshipsWon           Championship[]
  fightNightPlayer1          FightNightMatchup[]       @relation("FightNightPlayer1")
  fightNightPlayer2          FightNightMatchup[]       @relation("FightNightPlayer2")
  fightNightWinner           FightNightMatchup[]       @relation("FightNightWinner")

  @@map("users")
}

model Player {
  id            Int      @id @default(autoincrement())
  steamId       String?  @map("steam_id")
  steamUsername String?  @map("steam_username")
  steamAvatar   String?  @map("steam_avatar")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("players")
}

model Discord {
  discordId       String  @id @map("discord_id")
  discordUsername String? @map("discord_username")
  discordAvatar   String? @map("discord_avatar")
  playerSteamId   String? @unique @map("player_steam_id")

  user User? @relation(fields: [playerSteamId], references: [steamId])

  @@map("discord")
}

model Punishment {
  id            Int     @id @default(autoincrement())
  playerSteamId String? @map("player_steam_id")
  punishedBy    String? @map("punished_by")
  duration      Int?
  startDateTime Int?    @map("start_date_time")
  status        Int?
  severity      Int?
  reason        String?

  player   User? @relation("PunishmentReceiver", fields: [playerSteamId], references: [steamId])
  punisher User? @relation("PunishmentGiver", fields: [punishedBy], references: [steamId])

  @@map("punishment")
}

// Community Models
model Thread {
  id         Int      @id @default(autoincrement())
  title      String
  content    String
  categories String?
  createdAt  DateTime @default(now()) @map("created_at")
  bumpedAt   DateTime @default(now()) @map("bumped_at")
  owner      String?
  hidden     Int      @default(0)

  user  User?  @relation(fields: [owner], references: [steamId])
  posts Post[]

  @@map("threads")
}

model Post {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  thread    Int
  owner     String?
  hidden    Int      @default(0)

  threadObj Thread @relation(fields: [thread], references: [id])
  user      User?  @relation(fields: [owner], references: [steamId])

  @@map("posts")
}

model Activity {
  id          Int     @id @default(autoincrement())
  threadCount Int     @map("thread_count")
  postCount   Int     @map("post_count")
  period      Int
  owner       String?

  user User? @relation(fields: [owner], references: [steamId])

  @@map("activity")
}

model Moderator {
  steamId    String @id @map("steam_id")
  staffType  Int?   @map("staff_type") // 0 = head admin, 1 = normal admin
  divisionId Int?   @map("division_id")

  user     User      @relation(fields: [steamId], references: [steamId])
  division Division? @relation(fields: [divisionId], references: [id])

  @@map("moderators")
}

// League Structure Models
model Region {
  id     Int    @id @default(autoincrement())
  name   String
  hidden Int    @default(0)

  seasons Season[]
  teams   Team[]

  @@map("regions")
}

model Season {
  id        Int @id @default(autoincrement())
  seasonNum Int @map("season_num")
  numWeeks  Int @map("num_weeks")
  regionId  Int @map("region_id")

  region          Region           @relation(fields: [regionId], references: [id])
  teams           Team[]
  matches         Match[]
  playoffs        Playoff[]
  teamsHistory    TeamsHistory[]
  paymentTrackers PaymentTracker[]
  globalNa        Global[]         @relation("GlobalNaSeason")
  globalEu        Global[]         @relation("GlobalEuSeason")
  globalAus       Global[]         @relation("GlobalAusSeason")
  globalSa        Global[]         @relation("GlobalSaSeason")
  globalAsia      Global[]         @relation("GlobalAsiaSeason")

  @@map("seasons")
}

model Division {
  id         Int    @id @default(autoincrement())
  name       String
  signupCost Float  @default(0.00) @map("signup_cost")
  hidden     Int    @default(0)

  teams        Team[]
  moderators   Moderator[]
  teamsHistory TeamsHistory[]

  @@map("divisions")
}

model Playoff {
  id           Int     @id @default(autoincrement())
  seasonId     Int     @map("season_id")
  numRounds    Int?    @map("num_rounds")
  doubleElim   Int?    @map("double_elim")
  isTournament Boolean @map("is_tournament")

  season  Season  @relation(fields: [seasonId], references: [id])
  matches Match[]

  @@map("playoffs")
}

// Team Models
model Team {
  id                  Int      @id @default(autoincrement())
  name                String
  acronym             String?
  avatar              String?
  wins                Int      @default(0)
  losses              Int      @default(0)
  gamesWon            Int      @default(0) @map("games_won")
  gamesLost           Int      @default(0) @map("games_lost")
  pointsScored        Int      @default(0) @map("points_scored")
  pointsScoredAgainst Int      @default(0) @map("points_scored_against")
  divisionId          Int?     @map("division_id")
  regionId            Int?     @map("region_id")
  seasonId            Int?     @map("season_id")
  is1v1               Int      @default(0) @map("is_1v1")
  status              Int      @default(0)
  paymentStatus       Int      @default(0) @map("payment_status")
  joinPassword        String?  @map("join_password")
  createdAt           DateTime @default(now()) @map("created_at")

  division Division? @relation(fields: [divisionId], references: [id])
  region   Region?   @relation(fields: [regionId], references: [id])
  season   Season?   @relation(fields: [seasonId], references: [id])

  players         PlayerInTeam[]
  pendingPlayers  PendingPlayer[]
  deniedPlayers   DeniedPlayer[]
  teamnameHistory TeamnameHistory[]
  homeMatches     Match[]           @relation("HomeTeam")
  awayMatches     Match[]           @relation("AwayTeam")
  wonMatches      Match[]           @relation("WinnerTeam")
  payments        Payment[]
  mapBanActions   MapBanAction[]
  teamsHistory    TeamsHistory[]

  @@map("teams")
}

model TeamsHistory {
  id                  Int      @id @default(autoincrement())
  teamId              Int      @map("team_id")
  name                String
  acronym             String?
  avatar              String?
  wins                Int      @default(0)
  losses              Int      @default(0)
  gamesWon            Int      @default(0) @map("games_won")
  gamesLost           Int      @default(0) @map("games_lost")
  pointsScored        Int      @default(0) @map("points_scored")
  pointsScoredAgainst Int      @default(0) @map("points_scored_against")
  divisionId          Int?     @map("division_id")
  regionId            Int?     @map("region_id")
  seasonId            Int      @map("season_id")
  is1v1               Int      @default(0) @map("is_1v1")
  status              Int      @default(0)
  paymentStatus       Int      @default(0) @map("payment_status")
  joinPassword        String?  @map("join_password")
  createdAt           DateTime @default(now()) @map("created_at")

  team     Team      @relation(fields: [teamId], references: [id])
  division Division? @relation(fields: [divisionId], references: [id])
  season   Season    @relation(fields: [seasonId], references: [id])

  @@map("teams_history")
}

model PlayerInTeam {
  playerSteamId   String   @map("player_steam_id")
  teamId          Int      @map("team_id")
  active          Int      @default(1)
  permissionLevel Int      @default(0) @map("permission_level")
  paymentStatus   Int      @default(0) @map("payment_status")
  startedAt       DateTime @default(now()) @map("started_at")
  leftAt          String   @default("0") @map("left_at")

  player User @relation(fields: [playerSteamId], references: [steamId])
  team   Team @relation(fields: [teamId], references: [id])

  @@id([playerSteamId, teamId])
  @@map("players_in_teams")
}

model PendingPlayer {
  playerSteamId String @map("player_steam_id")
  teamId        Int    @map("team_id")
  status        Int    @default(0)

  player User @relation(fields: [playerSteamId], references: [steamId])
  team   Team @relation(fields: [teamId], references: [id])

  @@id([playerSteamId, teamId])
  @@map("pending_players")
}

model DeniedPlayer {
  playerSteamId String   @map("player_steam_id")
  teamId        Int      @map("team_id")
  reason        String?
  adminId       String?  @map("admin_id")
  deniedAt      DateTime @default(now()) @map("denied_at")

  player User @relation(fields: [playerSteamId], references: [steamId])
  team   Team @relation(fields: [teamId], references: [id])

  @@id([playerSteamId, teamId])
  @@map("denied_players")
}

model TeamnameHistory {
  teamId     Int      @map("team_id")
  name       String?
  changeDate DateTime @default(now()) @map("change_date")

  team Team @relation(fields: [teamId], references: [id])

  @@id([teamId, changeDate])
  @@map("teamname_history")
}

// Match Models
model Match {
  id            Int     @id @default(autoincrement())
  homeTeamId    Int     @map("home_team_id")
  awayTeamId    Int     @map("away_team_id")
  winnerId      Int?    @map("winner_id")
  winnerScore   Int?    @map("winner_score")
  loserScore    Int?    @map("loser_score")
  seasonId      Int     @map("season_id")
  seasonNo      Int     @map("season_no")
  playoffId     Int?    @map("playoff_id")
  playoffRound  Int?    @map("playoff_round")
  weekNo        Int?    @map("week_no")
  boSeries      Int?    @map("bo_series")
  boGames       Int?    @map("bo_games")
  matchDateTime String? @map("match_date_time")
  status        Int     @default(0)
  submittedBy   String? @map("submitted_by")
  submittedAt   Int?    @map("submitted_at")

  homeTeam  Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam  Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])
  winner    Team?    @relation("WinnerTeam", fields: [winnerId], references: [id])
  season    Season   @relation(fields: [seasonId], references: [id])
  playoff   Playoff? @relation(fields: [playoffId], references: [id])
  submitter User?    @relation(fields: [submittedBy], references: [steamId])

  games        Game[]
  matchComms   MatchComm[]
  demos        Demo[]
  matchMapBans MatchMapBan[]

  @@map("matches")
}

model Game {
  id                   Int  @id @default(autoincrement())
  matchId              Int? @map("match_id")
  fightNightMatchupsId Int? @map("fight_night_matchups_id")
  gameNum              Int  @map("game_num")
  homeTeamScore        Int? @map("home_team_score")
  awayTeamScore        Int? @map("away_team_score")
  arenaId              Int? @map("arena_id")

  match             Match?             @relation(fields: [matchId], references: [id])
  fightNightMatchup FightNightMatchup? @relation(fields: [fightNightMatchupsId], references: [id])
  arena             Arena?             @relation(fields: [arenaId], references: [id])

  @@map("games")
}

model MatchComm {
  id               Int     @id @default(autoincrement())
  content          String?
  reschedule       String?
  rescheduleStatus Int?    @map("reschedule_status")
  createdAt        Int?    @map("created_At")
  matchId          Int     @map("match_id")
  owner            String?

  match Match @relation(fields: [matchId], references: [id])
  user  User? @relation(fields: [owner], references: [steamId])

  @@map("match_comms")
}

// Arena/Map Models
model Arena {
  id         Int     @id @default(autoincrement())
  name       String
  avatar     String?
  playoffMap Int     @default(0) @map("playoff_map")

  games             Game[]
  mapsInPool        MapInPool[]
  mapBanActions     MapBanAction[]
  championshipGames ChampionshipGame[]

  @@map("arenas")
}

model MapBan {
  id         Int     @id @default(autoincrement())
  name       String
  avatar     String?
  playoffMap Int     @default(0) @map("playoff_map")

  @@map("map_bans")
}

model MapBanPool {
  id        Int      @id @default(autoincrement())
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  mapsInPool   MapInPool[]
  matchMapBans MatchMapBan[]

  @@map("map_ban_pools")
}

model MapInPool {
  poolId   Int @map("pool_id")
  arenaId  Int @map("arena_id")
  orderNum Int @map("order_num")

  pool  MapBanPool @relation(fields: [poolId], references: [id])
  arena Arena      @relation(fields: [arenaId], references: [id])

  @@id([poolId, arenaId])
  @@map("maps_in_pool")
}

model MatchMapBan {
  id               Int      @id @default(autoincrement())
  matchId          Int?     @map("match_id")
  poolId           Int?     @map("pool_id")
  currentTurn      Int      @default(0) @map("current_turn")
  banPhaseComplete Boolean  @default(false) @map("ban_phase_complete")
  startedAt        DateTime @default(now()) @map("started_at")
  completedAt      String?  @map("completed_at")

  match   Match?         @relation(fields: [matchId], references: [id])
  pool    MapBanPool?    @relation(fields: [poolId], references: [id])
  actions MapBanAction[]

  @@map("match_map_bans")
}

model MapBanAction {
  id            Int      @id @default(autoincrement())
  matchMapBanId Int?     @map("match_map_ban_id")
  teamId        Int?     @map("team_id")
  playerSteamId String?  @map("player_steam_id")
  arenaId       Int?     @map("arena_id")
  actionType    String   @map("action_type")
  actionOrder   Int      @map("action_order")
  createdAt     DateTime @default(now()) @map("created_at")

  matchMapBan MatchMapBan? @relation(fields: [matchMapBanId], references: [id])
  team        Team?        @relation(fields: [teamId], references: [id])
  player      User?        @relation(fields: [playerSteamId], references: [steamId])
  arena       Arena?       @relation(fields: [arenaId], references: [id])

  @@map("map_ban_actions")
}

// Payment Models
model Payment {
  paymentId    String  @id @map("payment_id")
  purchasedFor String  @map("purchased_for")
  purchasedBy  String  @map("purchased_by")
  amount       String
  currency     String?
  purchaseDate String  @map("purchase_date")
  description  String?
  teamId       Int?    @map("team_id")

  forUser User  @relation("PaymentRecipient", fields: [purchasedFor], references: [steamId])
  byUser  User  @relation("PaymentPurchaser", fields: [purchasedBy], references: [steamId])
  team    Team? @relation(fields: [teamId], references: [id])

  @@map("payments")
}

model PaymentTracker {
  id            Int    @id @default(autoincrement())
  playerSteamId String @map("player_steam_id")
  seasonId      Int    @map("season_id")
  amount        Float

  player User   @relation(fields: [playerSteamId], references: [steamId])
  season Season @relation(fields: [seasonId], references: [id])

  @@unique([playerSteamId, seasonId])
  @@map("payment_tracker")
}

// Demo Models
model Demo {
  id            Int      @id @default(autoincrement())
  file          String
  playerSteamId String?  @map("player_steam_id")
  submittedBy   String?  @map("submitted_by")
  submittedAt   DateTime @default(now()) @map("submitted_at")
  matchId       Int?     @map("match_id")
  tournamentId  Int?     @map("tournament_id")
  fightNightId  Int?     @map("fight_night_id")
  title         String?
  description   String?

  player            User?              @relation("DemoPlayer", fields: [playerSteamId], references: [steamId])
  submitter         User?              @relation("DemoSubmitter", fields: [submittedBy], references: [steamId])
  match             Match?             @relation(fields: [matchId], references: [id])
  tournament        Tournament?        @relation(fields: [tournamentId], references: [id])
  fightNightMatchup FightNightMatchup? @relation(fields: [fightNightId], references: [id])
  reports           DemoReport[]

  @@map("demos")
}

model DemoReport {
  id            Int      @id @default(autoincrement())
  demoId        Int      @map("demo_id")
  reportedBy    String?  @map("reported_by")
  reportedAt    DateTime @default(now()) @map("reported_at")
  status        Int      @default(1)
  description   String?
  adminId       String?  @map("admin_id")
  adminComments String?  @map("admin_comments")

  demo     Demo  @relation(fields: [demoId], references: [id])
  reporter User? @relation(fields: [reportedBy], references: [steamId])
  admin    User? @relation("DemoReportAdmin", fields: [adminId], references: [steamId])

  @@map("demo_report")
}

// Tournament Models
model Tournament {
  id                  Int     @id @default(autoincrement())
  name                String
  description         String?
  bracketLink         String? @map("bracket_link")
  avatar              String?
  startedAt           String? @map("started_at")
  winner1SteamId      String? @map("winner1_steam_id")
  winner2SteamId      String? @map("winner2_steam_id")
  secondPlace1SteamId String? @map("second_place1_steam_id")
  secondPlace2SteamId String? @map("second_place2_steam_id")
  thirdPlace1SteamId  String? @map("third_place1_steam_id")
  thirdPlace2SteamId  String? @map("third_place2_steam_id")
  isTeamTournament    Boolean @default(false) @map("is_team_tournament")

  demos Demo[]

  @@map("tournaments")
}

model FightNight {
  id          Int     @id @default(autoincrement())
  card        String?
  description String?
  prizepool   Float   @default(0)
  startedAt   String? @map("started_at")

  matchups FightNightMatchup[]

  @@map("fight_night")
}

model FightNightMatchup {
  id             Int     @id @default(autoincrement())
  fightNightId   Int?    @map("fight_night_id")
  player1SteamId String? @map("player1_steam_id")
  player2SteamId String? @map("player2_steam_id")
  orderNum       Int     @map("order_num")
  winnerId       String? @map("winner_id")
  winnerScore    Int?    @map("winner_score")
  loserScore     Int?    @map("loser_score")
  boSeries       Int     @default(3) @map("bo_series")

  fightNight FightNight? @relation(fields: [fightNightId], references: [id])
  player1    User?       @relation("FightNightPlayer1", fields: [player1SteamId], references: [steamId])
  player2    User?       @relation("FightNightPlayer2", fields: [player2SteamId], references: [steamId])
  winner     User?       @relation("FightNightWinner", fields: [winnerId], references: [steamId])
  games      Game[]
  demos      Demo[]

  @@map("fight_night_matchups")
}

// Championship Models
model Championship {
  id        Int      @id @default(autoincrement())
  name      String
  startedAt DateTime @default(now()) @map("started_at")
  endedAt   String?  @map("ended_at")
  winner    String?
  status    Int      @default(0)
  avatar    String?

  winnerUser   User?                     @relation(fields: [winner], references: [steamId])
  participants ChampionshipParticipant[]
  matches      ChampionshipMatch[]

  @@map("championship")
}

model ChampionshipParticipant {
  id             Int      @id @default(autoincrement())
  championshipId Int?     @map("championship_id")
  steamId        String?  @map("steam_id")
  seed           Int?
  eliminated     Boolean  @default(false)
  hidden         Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  championship Championship? @relation(fields: [championshipId], references: [id])
  user         User?         @relation(fields: [steamId], references: [steamId])

  @@map("championship_participant")
}

model ChampionshipMatch {
  id             Int      @id @default(autoincrement())
  championshipId Int?     @map("championship_id")
  player1Id      String?  @map("player1_id")
  player2Id      String?  @map("player2_id")
  winnerId       String?  @map("winner_id")
  loserId        String?  @map("loser_id")
  winnerScore    Int?     @map("winner_score")
  loserScore     Int?     @map("loser_score")
  boSeries       Int      @map("bo_series")
  status         Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")

  championship Championship?      @relation(fields: [championshipId], references: [id])
  player1      User?              @relation("Player1", fields: [player1Id], references: [steamId])
  player2      User?              @relation("Player2", fields: [player2Id], references: [steamId])
  winner       User?              @relation("Winner", fields: [winnerId], references: [steamId])
  loser        User?              @relation("Loser", fields: [loserId], references: [steamId])
  games        ChampionshipGame[]

  @@map("championship_match")
}

model ChampionshipGame {
  id                  Int     @id @default(autoincrement())
  championshipMatchId Int     @map("championship_match_id")
  homePlayerScore     Int?    @map("home_player_score")
  awayPlayerScore     Int?    @map("away_player_score")
  gameNumber          Int     @map("game_number")
  arenaId             Int?    @map("arena_id")
  playedAt            String? @map("played_at")

  match ChampionshipMatch @relation(fields: [championshipMatchId], references: [id])
  arena Arena?            @relation(fields: [arenaId], references: [id])

  @@map("championship_game")
}

// System Models
model Notification {
  id          Int      @id @default(autoincrement())
  userSteamId String?  @map("user_steam_id")
  type        Int
  url         String
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userSteamId], references: [steamId])

  @@map("notifications")
}

model Global {
  id                 Int  @id @default(autoincrement())
  leagueFees         Int  @default(0) @map("league_fees")
  signupClosed       Int  @default(0) @map("signup_closed")
  rosterLocked       Int  @default(0) @map("roster_locked")
  paymentRequired    Int  @default(0) @map("payment_required")
  naSignupSeasonId   Int? @map("na_signup_season_id")
  euSignupSeasonId   Int? @map("eu_signup_season_id")
  ausSignupSeasonId  Int? @map("aus_signup_season_id")
  saSignupSeasonId   Int? @map("sa_signup_season_id")
  asiaSignupSeasonId Int? @map("asia_signup_season_id")

  naSignupSeason   Season? @relation("GlobalNaSeason", fields: [naSignupSeasonId], references: [id])
  euSignupSeason   Season? @relation("GlobalEuSeason", fields: [euSignupSeasonId], references: [id])
  ausSignupSeason  Season? @relation("GlobalAusSeason", fields: [ausSignupSeasonId], references: [id])
  saSignupSeason   Season? @relation("GlobalSaSeason", fields: [saSignupSeasonId], references: [id])
  asiaSignupSeason Season? @relation("GlobalAsiaSeason", fields: [asiaSignupSeasonId], references: [id])

  @@map("global")
}

model LeagueInfo {
  id                 Int      @id @default(autoincrement())
  intro              String
  description        String
  signupsDates       String   @map("signups_dates")
  regularSeasonDates String   @map("regular_season_dates")
  playoffsDates      String   @map("playoffs_dates")
  rostersLockDate    String   @map("rosters_lock_date")
  format             String
  matchTimes         String   @map("match_times")
  schedule           String
  playoffsFormat     String   @map("playoffs_format")
  lastUpdated        DateTime @default(now()) @map("last_updated")

  @@map("league_info")
}

model Announcement {
  id      Int    @id @default(autoincrement())
  content String
  visible Int    @default(0)

  @@map("announcements")
}
