# Database
DATABASE_URL=postgresql://user:password@localhost:5432/mgetf

# Application environment: production | staging | development
APP_ENVIRONMENT=development

# Steam Authentication (required)
STEAM_API_KEY=your-steam-api-key

# Discord OAuth (optional)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Cloudflare R2 / S3-compatible storage (optional)
S3_ENDPOINT=
S3_EU_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET_NAME=
CLOUDFLARE_PUBLIC_URL=

# PayPal (optional)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Session & JWT secrets (required — use 32+ random characters)
JWT_SECRET=change-me-to-a-random-64-hex-string
SESSION_SECRET=change-me-to-a-random-32-char-string

# Game server panel base URL (optional — defaults to https://panel.mge.tf)
MGE_PANEL_URL=https://panel.mge.tf

# Database connection pool size (optional — defaults to 10)
# Budget: replicas × (DB_POOL_MAX + 1 hub listener) × 2 (deploy overlap) + siblings ≤ ~97.
# At 2 replicas: 4 × 11 + 23 ≈ 67 of 97 usable connections. Do not raise above 10 without recalculating.
DB_POOL_MAX=10

# Real-time push notifications (optional — defaults to true)
# Set to false to disable SSE and fall back to static notifications (loaded on page render only).
REALTIME_NOTIFICATIONS_ENABLED=true
