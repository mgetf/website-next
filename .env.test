# Environment for Playwright / local E2E against docker-compose.test.yml
# or a local Postgres database named mgetf_test.

# Matches docker-compose.test.yml (host port 5433). CI overrides DATABASE_URL to :5432.
DATABASE_URL=postgresql://mgetf:mgetf@localhost:5433/mgetf_test
APP_ENVIRONMENT=development
STEAM_API_KEY=test-steam-api-key-not-used
JWT_SECRET=e2e-test-jwt-secret-at-least-32-chars-long
SESSION_SECRET=e2e-test-session-secret-32chars!!
PUBLIC_URL=http://localhost:4173
