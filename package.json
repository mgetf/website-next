		"prisma": "^7.0.1",
		"svelte": "^5.45.3",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"vite": "^7.2.6"
	},
	"trustedDependencies": [
		"@prisma/client",
		"@prisma/engines",
		"@tailwindcss/oxide",
		"esbuild",
		"prisma"
	],
