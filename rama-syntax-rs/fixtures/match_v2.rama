// .rama v2 — see DESIGN.md
// Specter paths + --> / !<--. Rust-like structs. fail / return. $$ pstates.

module mge.tf.rama.match-module/MatchModule topology matches

struct Match {
  :homeTeamId String
  :awayTeamId String
  :seasonId   String
  :status     String
  :homeScore  Long
  :awayScore  Long
  :winnerId   String
  :boGames    Long
}

struct MapBan {
  :turn       Long
  :homeTeamId String
  :awayTeamId String
  :remaining  Object
  :actions    Object
}

struct TeamStats {
  :wins   Long
  :losses Long
  :points Long
}

pstate $$matches:       Map<String, Match>
pstate $$map-bans:       Map<String, MapBan>
pstate $$team-stats:     Map<String, TeamStats>
pstate $$matches-by-team: Map<String, Map<String, String>> @subindexed

depot match-depot keyed-by matchId

// Event structs: the compiler generates a boundary validator per op and
// coerces JSON Integer payloads into the declared Long fields.
struct CreateMatchEvent {
  :matchId    String
  :homeTeamId String
  :awayTeamId String
  :seasonId   String
  :boGames    Long
  :pool       Object
}

struct BanMapEvent {
  :matchId String
  :teamId  String
  :arenaId String
}

struct SubmitScoreEvent {
  :matchId   String
  :homeScore Long
  :awayScore Long
}

op create-match(event: CreateMatchEvent) {
  let { matchId, homeTeamId, awayTeamId, seasonId, boGames, pool } = event
  let pool-set = set(pool)

  $$matches --> keypath(matchId) > existing
  fail "match-exists" if not(nil?(existing))

  $$matches !<-- keypath(matchId), termval({
    :homeTeamId homeTeamId
    :awayTeamId awayTeamId
    :seasonId   seasonId
    :status     "UNPLAYED"
    :homeScore  0
    :awayScore  0
    :boGames    boGames
  })

  $$map-bans !<-- keypath(matchId), termval({
    :turn       0
    :homeTeamId homeTeamId
    :awayTeamId awayTeamId
    :remaining  pool-set
    :actions    []
  })

  |hash homeTeamId
  $$matches-by-team !<-- keypath(homeTeamId, matchId), termval(seasonId)
  |hash awayTeamId
  $$matches-by-team !<-- keypath(awayTeamId, matchId), termval(seasonId)

  return {"ok" true "matchId" matchId}
}

op ban-map(event: BanMapEvent) {
  let { matchId, teamId, arenaId } = event

  $$map-bans --> keypath(matchId) > { turn, homeTeamId, awayTeamId, remaining }

  fail "no-ban-state" if turn == nil
  fail "not-your-turn" if teamId != (even?(turn) ? awayTeamId : homeTeamId)
  fail "arena-not-in-pool" if not(contains?(remaining, arenaId))

  $$map-bans !<-- keypath(matchId), multi-path(
    [:remaining termval(disj(remaining, arenaId))]
    [:turn termval(inc(turn))]
  )
  $$map-bans !<-- keypath(matchId, :actions), AFTER-ELEM, termval({:teamId teamId :arenaId arenaId})

  return {"ok" true "matchId" matchId "banned" arenaId "turn" inc(turn)}
}

op submit-score(event: SubmitScoreEvent) {
  let { matchId, homeScore, awayScore } = event
  let hs = homeScore
  let as = awayScore

  $$matches --> keypath(matchId) > { status, homeTeamId, awayTeamId, boGames }

  fail "match-not-found" if status == nil
  fail "already-played" if status != "UNPLAYED"
  fail "incomplete-or-invalid-score" if not(
    or(and(>=(hs, boGames), >(hs, as)), and(>=(as, boGames), >(as, hs)))
  )

  let winnerId = >(hs, as) ? homeTeamId : awayTeamId
  let loserId = =(winnerId, homeTeamId) ? awayTeamId : homeTeamId

  $$matches !<-- keypath(matchId), multi-path(
    [:status termval("PLAYED")]
    [:homeScore termval(hs)]
    [:awayScore termval(as)]
    [:winnerId termval(winnerId)]
  )

  |hash winnerId
  $$team-stats !<-- keypath(winnerId, :wins), nil->val(0), term(inc)
  $$team-stats !<-- keypath(winnerId, :points), nil->val(0), term(inc)
  |hash loserId
  $$team-stats !<-- keypath(loserId, :losses), nil->val(0), term(inc)

  return {"ok" true "matchId" matchId "winnerId" winnerId "homeScore" hs "awayScore" as}
}
