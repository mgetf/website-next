{
  "name": "mge-next",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "bun@1.x.x",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=999999.0.0",
    "pnpm": ">=999999.0.0",
    "yarn": ">=999999.0.0"
  },
  "scripts": {
    "preinstall": "node -e \"const ua = process.env.npm_config_user_agent; if (!ua || !ua.startsWith('bun/')) { process.stderr.write('\\n\\x1b[31mError: This project requires bun. Use: bun install\\x1b[0m\\n\\n'); process.exit(1); }\"",
    "dev": "vite dev",
    "dev:prod": "bun --env-file=.env.production run dev",
    "build": "prisma generate && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo '' && husky",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:prod": "dotenv -e .env.production -- prisma migrate deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundary-check": "bun run scripts/boundary-check.ts",
    "rama:smoke": "bun run scripts/rama-smoke.ts",
    "rama:cluster:up": "bash scripts/rama-cluster.sh up",
    "rama:cluster:deploy": "bash scripts/rama-cluster.sh deploy",
    "rama:cluster:up-deploy": "bash scripts/rama-cluster.sh up-deploy",
    "rama:cluster:status": "bash scripts/rama-cluster.sh status",
    "test:e2e": "bun --env-file=.env.test playwright test",
    "test:e2e:ui": "bun --env-file=.env.test playwright test --ui",
    "db:studio": "prisma studio",
    "db:studio:prod": "dotenv -e .env.production -- prisma studio",
    "knip": "knip"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/archiver": "^7.0.0",
    "@types/node": "^25.9.5",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "knip": "^6.29.0",
    "lint-staged": "^17.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prisma": "^7.9.0",
    "svelte": "^5.56.7",
    "svelte-check": "^4.7.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  },
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "@tailwindcss/oxide",
    "prisma"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1093.0",
    "@aws-sdk/s3-request-presigner": "^3.1093.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsonwebtoken": "^9.0.10",
    "archiver": "7.0.1",
    "chart.js": "^4.5.1",
    "flag-icons": "^7.5.0",
    "fuse.js": "^7.5.0",
    "jsonwebtoken": "^9.0.3",
    "node-steam-openid": "^2.0.0",
    "pg": "^8.22.0",
    "svelte-dnd-action": "^0.9.74",
    "svelte-exmarkdown": "^5.0.2",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.{js,ts,svelte,css,html,json,md,yaml,yml}": "prettier --check"
  }
}
