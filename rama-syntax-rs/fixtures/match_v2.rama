// ASPIRATIONAL v2 — see DESIGN.md.
// Specter paths + --> / !<--. Rust-like structs. fail/return. Whole-map termval.

module Match

struct Match {
  :homeTeamId String
  :awayTeamId String
  :seasonId   String
  :status     String
  :homeScore  Long
  :awayScore  Long
  :winnerId   String
  :boGames    Long
}

struct MapBan {
  :turn       Long
  :homeTeamId String
  :awayTeamId String
  :remaining  Object
  :actions    Object
}

struct TeamStats {
  :wins   Long
  :losses Long
  :points Long
}

pstate matches:       Map<String, Match>
pstate mapBans:       Map<String, MapBan>
pstate teamStats:     Map<String, TeamStats>
pstate matchesByTeam: Map<String, Map<String, String>> @subindexed

depot matchDepot keyed-by matchId

op create-match(event) {
  let { matchId, homeTeamId, awayTeamId, seasonId, boGames, pool } = event
  let bo = long(boGames)
  let pool-set = set(pool)

  $$matches --> keypath(matchId) > existing
  fail "match-exists" if not(nil?(existing))

  $$matches !<-- keypath(matchId), termval({
    :homeTeamId homeTeamId
    :awayTeamId awayTeamId
    :seasonId   seasonId
    :status     "UNPLAYED"
    :homeScore  0
    :awayScore  0
    :boGames    bo
  })

  $$mapBans !<-- keypath(matchId), termval({
    :turn       0
    :homeTeamId homeTeamId
    :awayTeamId awayTeamId
    :remaining  pool-set
    :actions    []
  })

  |hash homeTeamId
  $$matchesByTeam !<-- keypath(homeTeamId, matchId), termval(seasonId)
  |hash awayTeamId
  $$matchesByTeam !<-- keypath(awayTeamId, matchId), termval(seasonId)

  return {"ok" true "matchId" matchId}
}

op ban-map(event) {
  let { matchId, teamId, arenaId } = event

  $$mapBans --> keypath(matchId) > { turn, homeTeamId, awayTeamId, remaining }

  fail "no-ban-state" if turn == nil
  fail "not-your-turn" if teamId != (even?(turn) ? awayTeamId : homeTeamId)
  fail "arena-not-in-pool" if not(contains?(remaining, arenaId))

  $$mapBans !<-- keypath(matchId), multi-path(
    [:remaining termval(disj(remaining, arenaId))]
    [:turn termval(inc(turn))]
  )
  $$mapBans !<-- keypath(matchId, :actions), AFTER-ELEM, termval({:teamId teamId :arenaId arenaId})

  return {"ok" true "matchId" matchId "banned" arenaId "turn" inc(turn)}
}

op submit-score(event) {
  let { matchId, homeScore, awayScore } = event
  let hs = long(homeScore)
  let as = long(awayScore)

  $$matches --> keypath(matchId) > { status, homeTeamId, awayTeamId, boGames }

  fail "match-not-found" if status == nil
  fail "already-played" if status != "UNPLAYED"
  fail "incomplete-or-invalid-score" if not(
    or(and(>=(hs, boGames), >(hs, as)), and(>=(as, boGames), >(as, hs)))
  )

  let winnerId = >(hs, as) ? homeTeamId : awayTeamId
  let loserId = =(winnerId, homeTeamId) ? awayTeamId : homeTeamId

  $$matches !<-- keypath(matchId), multi-path(
    [:status termval("PLAYED")]
    [:homeScore termval(hs)]
    [:awayScore termval(as)]
    [:winnerId termval(winnerId)]
  )

  |hash winnerId
  $$teamStats !<-- keypath(winnerId, :wins), nil->val(0), term(inc)
  $$teamStats !<-- keypath(winnerId, :points), nil->val(0), term(inc)
  |hash loserId
  $$teamStats !<-- keypath(loserId, :losses), nil->val(0), term(inc)

  return {"ok" true "matchId" matchId "winnerId" winnerId "homeScore" hs "awayScore" as}
}
