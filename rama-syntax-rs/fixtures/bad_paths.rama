// Intentionally ill-typed paths — exercises the type-checker stub.

pstate $$matches {
  String -> fixed {
    "status": String
    "homeScore": Long
  }
}

ramaop bad>(*match-id) {
  // unknown field
  $$matches --> keypath(*match-id, "notAField") > *x;

  // navigator wrongly nested inside keypath (MatchModule scar)
  $$matches !<-- keypath(*match-id, "actions", "AFTER-ELEM"), termval({"x" 1});

  // transform missing terminator
  $$matches !<-- keypath(*match-id, "status");

  // termval type mismatch
  $$matches !<-- keypath(*match-id, "homeScore"), termval("nope");

  // unknown pstate
  $$nope --> keypath(*match-id) > *y;
}
